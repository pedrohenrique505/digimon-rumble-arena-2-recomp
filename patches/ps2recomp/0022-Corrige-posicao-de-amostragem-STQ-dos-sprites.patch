diff --git a/ps2xRuntime/src/lib/gs/gs_cpu_backend.cpp b/ps2xRuntime/src/lib/gs/gs_cpu_backend.cpp
index b2d2151..e35f77a 100644
--- a/ps2xRuntime/src/lib/gs/gs_cpu_backend.cpp
+++ b/ps2xRuntime/src/lib/gs/gs_cpu_backend.cpp
@@ -1247,14 +1247,19 @@ void GSCpuBackend::DrawSprite(const GSPrimitiveBatch &batch)
         if (spriteH < 1.0f)
             spriteH = 1.0f;
 
+        // GS samples attributes at integer pixel positions. Adding a half
+        // pixel here shifts STQ nearest sampling into the next texel when
+        // the game already supplied half-texel coordinates. Keep the legacy
+        // UV path's bias paired with its integer endpoint quantization.
+        const float sampleOffset = state.prim.fst ? 0.5f : 0.0f;
         for (int y = drawY0; y <= drawY1; ++y)
         {
-            float ty = (static_cast<float>(y - unclippedY0) + 0.5f) / spriteH;
+            float ty = (static_cast<float>(y - unclippedY0) + sampleOffset) / spriteH;
             float texVf = v0f + (v1f - v0f) * ty;
 
             for (int x = drawX0; x <= drawX1; ++x)
             {
-                float tx = (static_cast<float>(x - unclippedX0) + 0.5f) / spriteW;
+                float tx = (static_cast<float>(x - unclippedX0) + sampleOffset) / spriteW;
                 float texUf = u0f + (u1f - u0f) * tx;
                 uint32_t texel = 0xFFFF00FFu;
                 if (state.prim.fst)
