+    size_t findFirstGifEopPacketEnd(const uint8_t *data, size_t sizeBytes, bool &outFoundEop)
+    {
+        outFoundEop = false;
+        size_t offset = 0u;
+        while (offset + 16u <= sizeBytes)
+        {
+            uint64_t tagLo = 0u;
+            std::memcpy(&tagLo, data + offset, sizeof(tagLo));
+            offset += 16u;
+
+            const uint32_t nloop = static_cast<uint32_t>(tagLo & 0x7FFFu);
+            const bool eop = ((tagLo >> 15u) & 1u) != 0u;
+            const uint8_t flg = static_cast<uint8_t>((tagLo >> 58u) & 0x3u);
+            uint32_t nreg = static_cast<uint32_t>((tagLo >> 60u) & 0xFu);
+            if (nreg == 0u)
+                nreg = 16u;
+
+            uint64_t payloadBytes = 0u;
+            if (flg == 0u) // PACKED
+            {
+                payloadBytes = static_cast<uint64_t>(nloop) * nreg * 16ull;
+            }
+            else if (flg == 1u) // REGLIST, padded to a quadword
+            {
+                payloadBytes = static_cast<uint64_t>(nloop) * nreg * 8ull;
+                payloadBytes = (payloadBytes + 15ull) & ~15ull;
+            }
+            else // IMAGE (2) or DISABLED (3)
+            {
+                payloadBytes = static_cast<uint64_t>(nloop) * 16ull;
+            }
+
+            if (payloadBytes > sizeBytes - offset)
+            {
+                return sizeBytes;
+            }
+            offset += static_cast<size_t>(payloadBytes);
+            if (eop)
+            {
+                outFoundEop = true;
+                return offset;
+            }
+        }
+        return sizeBytes;
+    }
 }
 
