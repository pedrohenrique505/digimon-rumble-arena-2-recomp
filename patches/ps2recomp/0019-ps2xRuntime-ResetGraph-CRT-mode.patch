From f2894ba3367d5d17ab0d9374a3861a1b6d80f020 Mon Sep 17 00:00:00 2001
From: Pedro Henrique <pedro88rising@gmail.com>
Date: Sun, 8 Nov 2026 16:02:06 -0300
Subject: [PATCH] ps2xRuntime: delegar modo CRT de sceGsResetGraph ao syscall

---
 ps2xRuntime/src/lib/Kernel/Stubs/GS.cpp | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/ps2xRuntime/src/lib/Kernel/Stubs/GS.cpp b/ps2xRuntime/src/lib/Kernel/Stubs/GS.cpp
index aed4cb5..b27a78d 100644
--- a/ps2xRuntime/src/lib/Kernel/Stubs/GS.cpp
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/GS.cpp
@@ -790,7 +790,7 @@ namespace ps2_stubs
         uint32_t omode = getRegU32(ctx, 6);
         uint32_t ffmode = getRegU32(ctx, 7);
 
-        if (mode == 0)
+        if (mode == 0 || mode == 5)
         {
             if (runtime && !runtime->syncCoreSubsystems())
             {
@@ -802,6 +802,20 @@ namespace ps2_stubs
             g_gparam.omode = static_cast<uint8_t>(omode & 0xFF);
             g_gparam.ffmode = static_cast<uint8_t>(ffmode & 0x1);
             writeGsGParamToScratch(runtime);
+            // The native libgs routine delegates mode selection to SetGsCrt.
+            // Its HLE replaces that routine, so it must perform the same call.
+            // Use a private context: ResetGraph's argument registers have a
+            // different layout and remain visible to the guest caller.
+            R5900Context crtContext = *ctx;
+            SET_GPR_U32(&crtContext, 4, interlace & 1u);
+            SET_GPR_U32(&crtContext, 5, omode & 0xffu);
+            SET_GPR_U32(&crtContext, 6, ffmode & 1u);
+            ps2_syscalls::SetGsCrt(rdram, &crtContext, runtime);
+            if (mode == 5)
+            {
+                setReturnS32(ctx, 0);
+                return;
+            }
             uint64_t pmode = makePmode(1, 0, 0, 0, 0, 0x80);
             uint64_t smode2 = (interlace & 0x1) | ((ffmode & 0x1) << 1);
             uint64_t dispfb = makeDispFb(0, 10, 0, 0, 0);
-- 
2.56.0

