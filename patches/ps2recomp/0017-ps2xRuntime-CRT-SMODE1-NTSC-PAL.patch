From a0deec5380facdf611d54a2b71fbfaf074bf3dc7 Mon Sep 17 00:00:00 2001
From: Pedro Henrique <pedro88rising@gmail.com>
Date: Sun, 8 Nov 2026 15:57:30 -0300
Subject: [PATCH] ps2xRuntime: preencher SMODE1 para os IDs CRT NTSC e PAL

---
 .../src/lib/Kernel/Syscalls/System.cpp        | 21 ++++++++++++++++++-
 1 file changed, 20 insertions(+), 1 deletion(-)

diff --git a/ps2xRuntime/src/lib/Kernel/Syscalls/System.cpp b/ps2xRuntime/src/lib/Kernel/Syscalls/System.cpp
index 9614016..c48adc2 100644
--- a/ps2xRuntime/src/lib/Kernel/Syscalls/System.cpp
+++ b/ps2xRuntime/src/lib/Kernel/Syscalls/System.cpp
@@ -6,7 +6,7 @@ namespace ps2_syscalls
     void GsSetCrt(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
     {
         int interlaced = getRegU32(ctx, 4); // $a0 - 0=non-interlaced, 1=interlaced
-        int videoMode = getRegU32(ctx, 5);  // $a1 - 0=NTSC, 1=PAL, 2=VESA, 3=HiVision
+        int videoMode = getRegU32(ctx, 5);  // $a1 - SDK CRT ID: 0x02=NTSC, 0x03=PAL
         int frameMode = getRegU32(ctx, 6);  // $a2 - 0=field, 1=frame
 
         if (runtime)
@@ -18,6 +18,25 @@ namespace ps2_syscalls
 
             gs.smode2 = smode2;
 
+            // Analog TV clock configuration, after PRST/SINT are released.
+            // SDK IDs and SMODE1 field layout: ps2sdk graph_mode.c and
+            // common/include/gs_privileged.h. GCONT keeps the selected output
+            // colour encoding. Other CRT families need their own clock tables;
+            // invalidate SMODE1 rather than retaining a stale TV mode.
+            if (videoMode == 0x02 || videoMode == 0x03)
+            {
+                gs.smode1 = (gs.smode1 & (1ull << 25)) |
+                    4ull | (32ull << 3) | (1ull << 10) |
+                    (static_cast<uint64_t>(videoMode) << 13) |
+                    (4ull << 21) | (1ull << 30) | (1ull << 32) |
+                    (1ull << 33) | (1ull << 34);
+            }
+            else
+            {
+                gs.smode1 = 0;
+                RUNTIME_LOG("PS2 GsSetCrt: SMODE1 not implemented for CRT ID=" << videoMode << std::endl);
+            }
+
             // Keep CRT1 enabled after the BIOS syscall selects a display mode.
             if ((gs.pmode & 0x3ull) == 0ull)
             {
-- 
