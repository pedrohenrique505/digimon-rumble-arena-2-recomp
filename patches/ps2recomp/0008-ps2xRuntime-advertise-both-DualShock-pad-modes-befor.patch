From dc9010d7a92fc504a7ebc8d9c7ae95aebe91be4c Mon Sep 17 00:00:00 2001
From: Pedro Henrique <pedro88rising@gmail.com>
Date: Sat, 7 Nov 2026 17:44:32 -0300
Subject: [PATCH] ps2xRuntime: advertise both DualShock pad modes before analog
 selection

Keep the supported mode table independent of the current digital/analog mode. Games enumerate the table looking for DualShock before calling scePadSetMainMode; reporting only the current digital ID prevents initialization. Update the current mode offset and cover enumeration through analog activation and reads.
---
 ps2xRuntime/src/lib/Kernel/Stubs/Pad.cpp | 13 ++++++--
 ps2xTest/src/pad_input_tests.cpp         | 40 ++++++++++++++++++++++--
 2 files changed, 48 insertions(+), 5 deletions(-)

diff --git a/ps2xRuntime/src/lib/Kernel/Stubs/Pad.cpp b/ps2xRuntime/src/lib/Kernel/Stubs/Pad.cpp
index b50a4cf..9a3e9e1 100644
--- a/ps2xRuntime/src/lib/Kernel/Stubs/Pad.cpp
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/Pad.cpp
@@ -527,16 +527,23 @@ namespace ps2_stubs
             setReturnS32(ctx, currentId);
             return;
         case 3: // PAD_MODECUROFFS
-            setReturnS32(ctx, 0);
+            setReturnS32(ctx, portState->analogMode ? 1 : 0);
             return;
         case 4: // PAD_MODETABLE
+            // Supported modes are independent of the current mode. Games
+            // enumerate this table while the pad is still digital to discover
+            // the analog mode index passed to scePadSetMainMode.
             if (index == -1)
             {
-                setReturnS32(ctx, 1); // one available mode
+                setReturnS32(ctx, 2);
             }
             else if (index == 0)
             {
-                setReturnS32(ctx, currentId);
+                setReturnS32(ctx, kPadTypeDigital);
+            }
+            else if (index == 1)
+            {
+                setReturnS32(ctx, kPadTypeDualShock);
             }
             else
             {
diff --git a/ps2xTest/src/pad_input_tests.cpp b/ps2xTest/src/pad_input_tests.cpp
index 07f9b7a..d1f696c 100644
--- a/ps2xTest/src/pad_input_tests.cpp
+++ b/ps2xTest/src/pad_input_tests.cpp
@@ -68,6 +68,42 @@ void register_pad_input_tests()
 {
     MiniTest::Case("PadInput", [](TestCase &tc)
                    {
+        tc.Run("mode enumeration finds analog before switching from digital", [](TestCase &t)
+               {
+            std::vector<uint8_t> rdram(PS2_RAM_SIZE, 0);
+            R5900Context ctx{};
+            ps2_stubs::scePadInit(rdram.data(), &ctx, nullptr);
+            openPadPort(ctx, rdram);
+            auto info = [&](uint32_t mode, int32_t index) {
+                setRegU32(ctx, 6, mode);
+                setRegU32(ctx, 7, static_cast<uint32_t>(index));
+                ps2_stubs::scePadInfoMode(rdram.data(), &ctx, nullptr);
+                return static_cast<int32_t>(getRegU32(&ctx, 2));
+            };
+            t.Equals(info(1, -1), 4, "pad starts digital");
+            const int count = info(4, -1);
+            int analogIndex = -1;
+            for (int i = 0; i < count; ++i)
+                if (info(4, i) == 7) analogIndex = i;
+            t.Equals(analogIndex, 1, "analog must be discoverable before SetMainMode");
+            t.Equals(info(4, 0), 4, "digital remains the first supported mode");
+            t.Equals(info(4, 2), 0, "out of range mode is absent");
+            t.Equals(info(4, -2), 0, "invalid negative index is absent");
+            if (analogIndex >= 0)
+            {
+                setRegU32(ctx, 6, static_cast<uint32_t>(analogIndex));
+                setRegU32(ctx, 7, 3);
+                ps2_stubs::scePadSetMainMode(rdram.data(), &ctx, nullptr);
+                t.Equals(info(1, -1), 7, "enumerated mode activates analog");
+                t.Equals(info(3, -1), 1, "current offset follows analog mode");
+                t.Equals(info(4, 0), 4, "supported modes do not change with current mode");
+                runPadRead(ctx, rdram);
+                t.Equals(rdram[kPadDataAddr + 1], static_cast<uint8_t>(0x73), "read reports analog ID");
+            }
+            closePadPort(ctx, rdram);
+            t.Equals(info(4, -1), 0, "closed pad has no modes");
+        });
+
         tc.Run("scePadRead uses override state", [](TestCase &t)
                {
             std::vector<uint8_t> rdram(PS2_RAM_SIZE, 0);
@@ -296,9 +332,9 @@ void register_pad_input_tests()
             setRegU32(ctx, 4, 0u);
             setRegU32(ctx, 5, 0u);
             setRegU32(ctx, 6, 4);
-            setRegU32(ctx, 7, 0u);
+            setRegU32(ctx, 7, 1u);
             ps2_stubs::scePadInfoMode(rdram.data(), &ctx, nullptr);
-            t.Equals(static_cast<uint32_t>(getRegU32(&ctx, 2)), static_cast<uint32_t>(7), "mode table entry should return DualShock in analog mode");
+            t.Equals(static_cast<uint32_t>(getRegU32(&ctx, 2)), static_cast<uint32_t>(7), "mode table index 1 should report DualShock");
 
             closePadPort(ctx, rdram);
         });
-- 
