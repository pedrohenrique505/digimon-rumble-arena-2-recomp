         applyDest(vd, result, dest);
         return;
     case 0x2C: // SUB
@@ -226,7 +243,7 @@
         return;
     case 0x2F: // MINI
         for (int c = 0; c < 4; c++)
-            result[c] = (vs[c] < vt[c]) ? vs[c] : vt[c];
+            result[c] = vuMinMax(vs[c], vt[c], false);
         applyDest(vd, result, dest);
         return;
 
