Subject: [PATCH] ps2xRuntime: preserve raw VU MIN/MAX operands

MIN/MAX select sign/magnitude operands without arithmetic clamping. Keep I
raw until consumed and cover vector, broadcast and immediate variants.

diff --git a/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp b/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp
--- a/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp
+++ b/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp
@@ -1695,7 +1695,7 @@
             execUpper(decoded.upper);
             float immediate = 0.0f;
             std::memcpy(&immediate, &decoded.lower, sizeof(immediate));
-            m_state.i = normalizeOperand(immediate);
+            m_state.i = immediate;
         }
         else if (decoded.upperVfShadowReg != 0u)
         {
diff --git a/ps2xRuntime/src/lib/vu/ps2_vu1_upper.cpp b/ps2xRuntime/src/lib/vu/ps2_vu1_upper.cpp
--- a/ps2xRuntime/src/lib/vu/ps2_vu1_upper.cpp
+++ b/ps2xRuntime/src/lib/vu/ps2_vu1_upper.cpp
@@ -7,6 +7,21 @@
 
 namespace
 {
+    // MIN/MAX select raw operands, including denormals and exponent 255.
+    // Compare their sign/magnitude encoding without host FP canonicalization.
+    float vuMinMax(float a, float b, bool maximum)
+    {
+        int32_t left, right;
+        std::memcpy(&left, &a, sizeof(left));
+        std::memcpy(&right, &b, sizeof(right));
+        const bool reverse = left < 0 && right < 0;
+        const bool chooseLeft = (maximum != reverse) ? left > right : left < right;
+        const int32_t bits = chooseLeft ? left : right;
+        float result;
+        std::memcpy(&result, &bits, sizeof(result));
+        return result;
+    }
+
     int32_t vuFloatToInt(float value, float scale)
     {
         const double scaled = static_cast<double>(value) * static_cast<double>(scale);
@@ -31,20 +46,22 @@
     uint8_t op = instr & 0x3F;
 
     float *vd = m_state.vf[fd];
+    const bool minMax = (op >= 0x10u && op <= 0x17u) ||
+                        op == 0x1Du || op == 0x1Fu || op == 0x2Bu || op == 0x2Fu;
     float normalizedVs[4];
     float normalizedVt[4];
     float normalizedAcc[4];
     for (uint32_t component = 0; component < 4u; ++component)
     {
-        normalizedVs[component] = normalizeOperand(m_state.vf[fs][component]);
-        normalizedVt[component] = normalizeOperand(m_state.vf[ft][component]);
+        normalizedVs[component] = minMax ? m_state.vf[fs][component] : normalizeOperand(m_state.vf[fs][component]);
+        normalizedVt[component] = minMax ? m_state.vf[ft][component] : normalizeOperand(m_state.vf[ft][component]);
         normalizedAcc[component] = normalizeOperand(m_state.acc[component]);
     }
     const float *vs = normalizedVs;
     const float *vt = normalizedVt;
     const float *acc = normalizedAcc;
     const float q = normalizeOperand(m_state.q);
-    const float i = normalizeOperand(m_state.i);
+    const float i = minMax ? m_state.i : normalizeOperand(m_state.i);
     float result[4];
 
     // Upper opcode decoding (bits 5:0 of upper word)
@@ -99,9 +116,9 @@
     case 0x12:
     case 0x13: // MAXbc
     {
-        float bc = broadcast(vt, op & 3);
-        for (int c = 0; c < 4; c++)
-            result[c] = (vs[c] > bc) ? vs[c] : bc;
+        float bc = vt[op & 3];
+        for (int c = 0; c < 4; c++)
+            result[c] = vuMinMax(vs[c], bc, true);
         applyDest(vd, result, dest);
         return;
     }
@@ -110,9 +127,9 @@
     case 0x16:
     case 0x17: // MINIbc
     {
-        float bc = broadcast(vt, op & 3);
-        for (int c = 0; c < 4; c++)
-            result[c] = (vs[c] < bc) ? vs[c] : bc;
+        float bc = vt[op & 3];
+        for (int c = 0; c < 4; c++)
+            result[c] = vuMinMax(vs[c], bc, false);
         applyDest(vd, result, dest);
         return;
     }
@@ -134,7 +151,7 @@
         return;
     case 0x1D: // MAXi
         for (int c = 0; c < 4; c++)
