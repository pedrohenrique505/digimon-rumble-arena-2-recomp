     MiniTest::Case("PS2VU1", [](TestCase &tc)
     {
+        tc.Run("MIN MAX preserve raw operands across vector broadcast and immediate forms", [](TestCase &t)
+        {
+            const uint32_t operands[][2] = {
+                {0u, 0x58u}, {0x80000058u, 0x80000020u},
+                {0u, 0x80000000u}, {0x7fc00001u, 0x7fffffffu},
+                {0xff800001u, 0xffc00001u}};
+            const uint8_t ops[] = {0x2b, 0x2f, 0x10, 0x14, 0x1d, 0x1f};
+            for (uint8_t op : ops)
+            for (const auto &pair : operands)
+            {
+                Vu1Fixture fx;
+                t.IsTrue(fx.initialize(), "VU fixture initializes");
+                VU1Interpreter vu;
+                for (int lane = 0; lane < 4; ++lane)
+                {
+                    std::memcpy(&vu.state().vf[1][lane], &pair[0], 4);
+                    std::memcpy(&vu.state().vf[2][lane], &pair[1], 4);
+                }
+                // Load I through its actual immediate instruction path.
+                writeVuInstructionPair(fx.code, 0, pair[1], kVuUpperNop | 0x80000000u);
+                writeVuInstructionPair(fx.code, 8, 0, makeVuUpper(op, 0xf, 2, 1, 3));
+                vu.execute(fx.code, PS2_VU1_CODE_SIZE, fx.data, PS2_VU1_DATA_SIZE,
