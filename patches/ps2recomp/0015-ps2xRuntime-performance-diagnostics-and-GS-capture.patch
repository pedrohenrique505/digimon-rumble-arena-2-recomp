+#pragma once
+#include <cfenv>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <stdexcept>
+namespace gscapture
+{
+inline bool enabled()
+{
+    static bool v = std::getenv("PS2X_GS_CAPTURE") != nullptr;
+    return v;
+}
+inline FILE *file = nullptr;
+inline std::recursive_mutex mutex;
+inline thread_local unsigned nesting = 0;
+inline uint64_t bytes = 0;
+inline void record(uint32_t kind, const void *data, uint32_t size)
+{
+    if (!file)
+        return;
+    if (kind != 11 && kind != 0 && kind != 4 && kind != 6)
+    {
+        uint32_t mode = std::fegetround();
+        record(11, &mode, sizeof(mode));
+    }
+    if (bytes + size + 8 > 512ull * 1024 * 1024)
+        throw std::runtime_error("GS capture exceeded 512 MiB");
+    uint32_t h[] = {kind, size};
+    if (std::fwrite(h, 1, 8, file) != 8 || (size && std::fwrite(data, 1, size, file) != size))
+        throw std::runtime_error("GS capture write failed");
+    bytes += size + 8;
+}
+inline void init(const void *vram, uint32_t size)
+{
+    if (!enabled())
+        return;
+    std::lock_guard<std::recursive_mutex> lock(mutex);
+    if (file)
+        throw std::runtime_error("GS capture cannot span multiple initializations");
+    file = std::fopen(std::getenv("PS2X_GS_CAPTURE"), "wx");
+    if (!file)
+        throw std::runtime_error("GS capture requires a new writable file");
+    std::fwrite("DRA2GS02", 1, 8, file);
+    record(0, vram, size);
+    std::fflush(file);
+    std::atexit(
+        []
+        {
+            if (file)
+                std::fclose(file);
+        });
+}
+struct Event
+{
+    std::unique_lock<std::recursive_mutex> lock;
+    bool active = false;
+    Event(uint32_t kind, const void *data, uint32_t size) : lock(mutex, std::defer_lock)
+    {
+        if (enabled())
+        {
+            lock.lock();
+            active = true;
+            if (nesting++ == 0)
+                record(kind, data, size);
+        }
+    }
+    ~Event()
+    {
+        if (active)
+            --nesting;
+    }
+};
+} // namespace gscapture
