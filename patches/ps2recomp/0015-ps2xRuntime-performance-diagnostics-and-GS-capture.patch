+inline bool noRaster()
+{
+    static bool v = []
+    {
+        auto p = std::getenv("PS2X_NO_RASTER");
+        return p && p[0] == '1';
+    }();
+    return v;
+}
+inline uint64_t wall()
+{
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+               std::chrono::steady_clock::now().time_since_epoch())
+        .count();
+}
+inline uint64_t cpu()
+{
+    timespec t{};
+    clock_gettime(CLOCK_THREAD_CPUTIME_ID, &t);
+    return uint64_t(t.tv_sec) * 1000000000 + t.tv_nsec;
+}
+enum Kind
+{
+    EE,
+    VU,
+    GS,
+    IOP,
+    Present,
+    Count
+};
+struct Counter
+{
+    std::atomic<uint64_t> cpu{0}, wall{0}, calls{0};
+};
+inline std::array<Counter, Count> counters;
+struct Scope;
+inline thread_local Scope *current = nullptr;
+struct Scope
+{
+    Kind kind;
+    Scope *parent = nullptr;
+    uint64_t c = 0, w = 0, childCpu = 0, childWall = 0;
+    bool active;
+    explicit Scope(Kind k) : kind(k), active(enabled())
+    {
+        if (active)
+        {
+            parent = current;
+            current = this;
+            c = cpu();
+            w = wall();
+        }
+    }
+    ~Scope()
+    {
+        if (active)
+        {
+            auto dc = cpu() - c, dw = wall() - w;
+            counters[kind].cpu.fetch_add(dc - childCpu, std::memory_order_relaxed);
+            counters[kind].wall.fetch_add(dw - childWall, std::memory_order_relaxed);
+            counters[kind].calls.fetch_add(1, std::memory_order_relaxed);
+            if (parent)
+            {
+                parent->childCpu += dc;
+                parent->childWall += dw;
+            }
+            current = parent;
+        }
+    }
+};
+inline uint32_t guestCounter(const uint8_t *ram);
+inline void frame(uint32_t target, uint64_t cycle, const uint8_t *ram)
+{
+    static uint32_t pc = []
+    {
+        auto p = std::getenv("PS2X_PERF_FRAME_PC");
+        return p ? uint32_t(std::strtoul(p, nullptr, 0)) : 0u;
+    }();
+    if (!pc || target != pc)
+        return;
+    static FILE *out = []
+    {
+        auto p = std::getenv("PS2X_PERF_FRAMES");
+        return p ? std::fopen(p, "wx") : nullptr;
+    }();
+    if (out)
+    {
+        std::fprintf(out, "{\"wall_ns\":%llu,\"ee_cycle\":%llu,\"guest_counter\":%u}\n",
+                     (unsigned long long)wall(), (unsigned long long)cycle, guestCounter(ram));
+        std::fflush(out);
+    }
+}
+inline uint32_t guestCounter(const uint8_t *ram)
+{
+    static uint32_t addr = []
+    {
+        auto p = std::getenv("PS2X_PERF_COUNTER");
+        return p ? uint32_t(std::strtoul(p, nullptr, 0)) : 0u;
+    }();
+    uint32_t value = 0;
+    if (addr && addr <= 32u * 1024 * 1024 - 4)
+        std::memcpy(&value, ram + addr, 4);
+    return value;
+}
+inline void report(uint32_t frames, uint64_t vsync)
+{
+    if (!enabled())
+        return;
+    static auto start = wall();
+    static uint64_t last = 0;
+    auto now = wall();
+    if (now - last < 1000000000)
+        return;
+    last = now;
+    static FILE *out = std::fopen(std::getenv("PS2X_PERF"), "wx");
+    if (!out)
+        return;
+    std::fprintf(
+        out, "{\"seconds\":%.9f,\"wall_ns\":%llu,\"guest_frames\":%u,\"vsync_ticks\":%llu,\"no_raster\":%s,\"exclusive\":{",
+        (now - start) / 1e9, (unsigned long long)now, frames, (unsigned long long)vsync, noRaster() ? "true" : "false");
+    const char *names[] = {"ee", "vu", "gs", "iop", "present"};
+    for (int i = 0; i < Count; i++)
+        std::fprintf(out, "%s\"%s\":{\"cpu_ns\":%llu,\"wall_ns\":%llu,\"calls\":%llu}", i ? "," : "",
+                     names[i], (unsigned long long)counters[i].cpu.load(),
+                     (unsigned long long)counters[i].wall.load(),
+                     (unsigned long long)counters[i].calls.load());
+    std::fputs("}}\n", out);
+    std::fflush(out);
+}
+} // namespace ps2perf
