+    in.read(reinterpret_cast<char *>(code.data()), code.size());
+    in.read(reinterpret_cast<char *>(data.data()), data.size());
+    in.read(reinterpret_cast<char *>(&expectedState), sizeof(expectedState));
+    in.read(reinterpret_cast<char *>(expectedData.data()), expectedData.size());
+    in.read(reinterpret_cast<char *>(&hash), sizeof(hash));
+    in.read(reinterpret_cast<char *>(&bytes), sizeof(bytes));
+    if (!in || in.peek() != std::char_traits<char>::eof())
+        throw std::runtime_error("truncated VU capture");
+    if (original->m_cachedVuCode || original->m_cachedMemory || original->m_activeVuData ||
+        original->m_activeGs || original->m_activeMemory)
+        throw std::runtime_error("VU capture contains host pointers");
+    GS sink;
+    std::vector<uint8_t> scratchVram(4 * 1024 * 1024);
+    sink.init(scratchVram.data(), scratchVram.size());
+    original->rebuildDecodedCodeCache(code.data(), code.size(), nullptr, 0);
+    double total = 0;
+    vuReplaySink = true;
+    for (unsigned iteration = 0; iteration < 6; iteration++)
+    {
+        auto replay = std::make_unique<VU1Interpreter>(*original);
+        auto input = data;
+        const auto started = ps2perf::wall();
+        replay->run(code.data(), code.size(), input.data(), input.size(), sink, nullptr, header[3]);
+        const auto elapsed = ps2perf::wall() - started;
+        if (std::memcmp(&replay->m_state, &expectedState, sizeof(expectedState)) || input != expectedData ||
+            vuGifHash != hash || vuGifBytes != bytes)
+            throw std::runtime_error("VU replay diverged: registers, data or emitted GIF");
+        if (iteration)
+            total += elapsed / 1e9;
+    }
+    vuReplaySink = false;
+    std::printf("{\"iterations\":5,\"mean_seconds\":%.9f,\"gif_bytes\":%llu,\"verified\":true}\n", total / 5,
+                (unsigned long long)bytes);
+    return 0;
+}
