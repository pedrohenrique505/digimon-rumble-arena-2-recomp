@@ -2,6 +2,8 @@
 
 #include "ps2_syscalls.h"
 
+#include <functional>
+
 namespace ps2_syscalls
 {
     void SifStopModule(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime);
@@ -17,4 +19,14 @@ namespace ps2_syscalls
     void sceSifCallRpc(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime);
     void sceSifSendCmd(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime);
     void sceRpcGetPacket(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime);
+
+    // IOP -> EE RPC: the IOP binds/calls a server the EE registered with sceSifRegisterRpc.
+    bool lookupEeRpcServer(uint8_t *rdram, uint32_t sid, uint32_t &server, uint32_t &buffer, uint32_t &callbackBuffer);
+    bool callEeRpcFromIop(uint8_t *rdram,
+                          PS2Runtime *runtime,
+                          uint32_t sid,
+                          uint32_t rpcNumber,
+                          const void *send,
+                          uint32_t sendSize,
+                          std::function<void(uint32_t resultAddress)> onComplete);
 }
diff --git a/ps2xRuntime/src/lib/ps2_iop_host.cpp b/ps2xRuntime/src/lib/ps2_iop_host.cpp
index 8d46e03..ba64fea 100644
--- a/ps2xRuntime/src/lib/ps2_iop_host.cpp
+++ b/ps2xRuntime/src/lib/ps2_iop_host.cpp
@@ -3,6 +3,7 @@
 #include "ps2_runtime.h"
 #include "ps2_stubs.h"
 #include "Kernel/Stubs/SIF.h"
+#include "Kernel/Syscalls/RPC.h"
 #include "runtime/ps2_memory.h"
 #include "Kernel/Stubs/MemoryCard.h"
 #include "Kernel/Syscalls/Common.h"
@@ -517,6 +518,22 @@ bool PS2IopHostAdapter::sendSifCommand(uint32_t commandId,
                                          packetSize);
 }
 
+bool PS2IopHostAdapter::bindEeRpc(uint32_t sid, uint32_t &server, uint32_t &buffer, uint32_t &callbackBuffer)
+{
+    uint8_t *const rdram = m_activeRdram ? m_activeRdram : m_runtime.memory().getRDRAM();
+    return ps2_syscalls::lookupEeRpcServer(rdram, sid, server, buffer, callbackBuffer);
+}
+
+bool PS2IopHostAdapter::callEeRpc(uint32_t sid,
+                                  uint32_t rpcNumber,
+                                  const void *send,
+                                  uint32_t sendSize,
+                                  std::function<void(uint32_t resultAddress)> onComplete)
+{
+    uint8_t *const rdram = m_activeRdram ? m_activeRdram : m_runtime.memory().getRDRAM();
+    return ps2_syscalls::callEeRpcFromIop(rdram, &m_runtime, sid, rpcNumber, send, sendSize, std::move(onComplete));
+}
+
 void PS2IopHostAdapter::log(ps2x::iop::LogLevel level, std::string_view message)
 {
     const char *prefix = "[ps2xIOP]";
